# cp deploy/.env.example deploy/.env  and fill in. Generate each secret with: openssl rand -hex 16
# (hex only: the values are embedded in database URLs)
POSTGRES_PASSWORD=
ADANO_DB_PASSWORD=
FRAUDLESS_DB_PASSWORD=

# Local defaults. For production use real domains WITHOUT http:// so Caddy provisions TLS, and ports 80/443.
# ADANO_SITE=adano.example.com
# FRAUDLESS_SITE=fraudless.example.com
# HTTP_PORT=80
# HTTPS_PORT=443

# Where the trained model artifact lives on the host
# FRAUDLESS_MODEL_HOST_DIR=../apps/fraudless-api/models/v1
