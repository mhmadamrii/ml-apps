# podman build -t adano-api apps/adano-api
FROM docker.io/library/python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=8 \
    HF_HOME=/opt/hf

WORKDIR /app

# CPU-only torch: the default Linux wheel drags in ~2 GB of CUDA libraries this service never uses.
RUN pip install torch==2.2.2 --index-url https://download.pytorch.org/whl/cpu
COPY requirements.lock .
RUN pip install -r requirements.lock

# Bake the embedding model into the image so startup needs no network (thesis section 4.3).
RUN python -c "from sentence_transformers import SentenceTransformer as S; S('paraphrase-multilingual-MiniLM-L12-v2')"

COPY app ./app

RUN useradd --system --uid 10001 app
USER app
ENV HF_HUB_OFFLINE=1

EXPOSE 8000
# DATABASE_URL must be provided at run time; there is no usable default inside a container.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
