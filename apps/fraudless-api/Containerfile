# podman build -t fraudless-api apps/fraudless-api
# Serving image only: the model artifact is mounted read-only, never baked in (train on the host with the CLI).
FROM docker.io/library/python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=8

WORKDIR /app
# The lock pins the exact scikit-learn/pandas/numpy the artifact was trained with; the API refuses a mismatch.
COPY requirements.lock .
RUN pip install -r requirements.lock

COPY fraudless ./fraudless

RUN useradd --system --uid 10001 app
USER app

ENV FRAUDLESS_MODEL_DIR=/models/v1

EXPOSE 8001
# DATABASE_URL must be provided at run time; mount the model dir at FRAUDLESS_MODEL_DIR.
CMD ["uvicorn", "fraudless.api.main:app", "--host", "0.0.0.0", "--port", "8001", "--proxy-headers"]
